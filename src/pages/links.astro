function getFaviconUrl(rawUrl: string) {
  try {
    let parseUrl: URL;
    if (rawUrl.startsWith("/")) {
      const base = import.meta.env.SITE || "/";
      parseUrl = new URL(rawUrl, base);
    } else {
      parseUrl = new URL(rawUrl);
    }
    return `https://favicone.com/${parseUrl.hostname}?s=64`;
  } catch {
    return null;
  }
}
---

<MainGridLayout title={title} description={description}>
<div class="mt-8">
  <div class="card-base p-6 rounded-[var(--radius-large)] mb-8">
    <h1 class="text-3xl font-bold mb-3 text-gray-800 dark:text-gray-100">{title}</h1>
    <p class="text-gray-600 dark:text-gray-300">{description}</p>
  </div>

  <div class="space-y-10">
    {linkGroups.map((group, groupIndex) => (
      <div key={groupIndex}>
        <h2 class="text-xl font-semibold mb-4 text-gray-800 dark:text-gray-100 flex items-center gap-2">
          <span class="w-1 h-5 bg-[var(--primary)] rounded-full"></span>
          {group.category}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {group.items.map((item, itemIndex) => {
            const favicon = getFaviconUrl(item.url);
            return (
              <a
                href={item.url}
                target={item.url.startsWith("/") ? "_self" : "_blank"}
                rel="noopener noreferrer"
                key={itemIndex}
                class="card-base p-5 rounded-[var(--radius-large)] transition hover:shadow-md hover:-translate-y-0.5 block group"
              >
                <div class="flex items-start gap-3">
                  <div class="shrink-0 w-10 h-10 rounded-lg bg-[var(--primary)]/10 flex items-center justify-center overflow-hidden relative">
                    {favicon ? (
                      <>
                        <img
                          src={favicon}
                          alt={item.name}
                          class="w-6 h-6 object-contain"
                          loading="lazy"
                          data-fallback="true"
                        />
                        <svg
                          class="w-6 h-6 absolute inset-0 m-auto hidden fallback-icon"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                        >
                          <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/>
                        </svg>
                      </>
                    ) : (
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"/>
                      </svg>
                    )}
                  </div>

                  <div class="flex-1 min-w-0">
                    <h3 class="text-base font-semibold text-gray-800 dark:text-gray-100 mb-1 flex items-center gap-2">
                      {item.name}
                      {!item.url.startsWith("/") && (
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="opacity-60 group-hover:opacity-100 transition-opacity">
                          <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/>
                        </svg>
                      )}
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-2">{item.desc}</p>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </div>
</div>

<ServerFooter />

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('img[data-fallback]').forEach((img) => {
      img.addEventListener('error', function () {
        this.onerror = null;
        this.style.display = 'none';
        const parent = this.parentElement;
        if (parent) {
          const fallback = parent.querySelector('.fallback-icon');
          if (fallback) {
            fallback.classList.remove('hidden');
          }
        }
      });
    });
  });
</script>
</MainGridLayout>  