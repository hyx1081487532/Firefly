---
// src/components/ServerFooter.astro
/**
 * 服务器专题页脚
 * 仅用于：服务器状态、成员列表、下载中心、教程等服务器相关页面
 */
---
<div class="mt-14 pt-6 border-t border-zinc-300 dark:border-zinc-700">
  <div class="grid md:grid-cols-3 gap-y-6 md:gap-x-6">
    <!-- 服务器信息 -->
    <div>
      <h3 class="text-base font-semibold text-[var(--primary)] mb-2">2311舰队</h3>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Minecraft Java版生存服务器<br/>
        玩家自建社区，非Mojang官方服务
      </p>
    </div>

    <!-- 快速跳转 -->
    <div>
      <h3 class="text-base font-semibold text-[var(--primary)] mb-2">快速访问</h3>
      <nav class="flex flex-col gap-1.5">
        <a href="/memberlists" class="text-sm text-neutral-600 dark:text-neutral-400 underline-offset-2 hover:text-[var(--primary)] hover:underline transition-colors">服务器成员</a>
        <a href="/downloads" class="text-sm text-neutral-600 dark:text-neutral-400 underline-offset-2 hover:text-[var(--primary)] hover:underline transition-colors">资源下载</a>
        <a href="/minecraft-guide" class="text-sm text-neutral-600 dark:text-neutral-400 underline-offset-2 hover:text-[var(--primary)] hover:underline transition-colors">服务器状态</a>
      </nav>
    </div>

    <!-- 提示信息 -->
    <div>
      <h3 class="text-base font-semibold text-[var(--primary)] mb-2">温馨提示</h3>
      <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        状态、存档数据仅供参考<br/>
        一切以游戏内实际为准
      </p>
    </div>
  </div>

  <div class="mt-6 pt-4 border-t border-zinc-200 dark:border-zinc-800 text-center text-xs text-neutral-500 dark:text-neutral-500">
    © 2311舰队 | Minecraft 是 Mojang Studios 商标
  </div>
</div>